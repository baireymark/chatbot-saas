ANTHROPIC_API_KEY=sk-ant-your-key-here
ADMIN_KEY=replace-with-a-long-random-string
MODEL=claude-haiku-5-5
PORT=3000

# Supabase: Project Settings > Database > Connection string
# Use the Session pooler (port 5432) for db:migrate and the Transaction pooler (port 6543) for the app on Vercel.
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
